{
  "name": "@cohorti/disclosure-guard",
  "version": "0.0.0",
  "private": true,
  "description": "Enforces the tier floor, recency, anti-laddering, query budget, and disclosure envelope before any proof is generated.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(no lint configured yet)\"",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@cohorti/service-kit": "workspace:*",
    "@cohorti/shared-types": "workspace:*",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
