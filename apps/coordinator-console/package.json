{
  "name": "@cohorti/coordinator-console",
  "version": "0.0.0",
  "private": true,
  "description": "Phase A human review: a qualified human reviews every inclusion and exclusion the triage agent produced before any patient is approached.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port ${PORT_COORDINATOR_CONSOLE:-3001}",
    "build": "next build",
    "start": "next start --port ${PORT_COORDINATOR_CONSOLE:-3001}",
    "clean": "rm -rf .next",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "@cohorti/shared-types": "workspace:*",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  }
}
