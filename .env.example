# Copy to .env and fill in. Nothing in this file is a real secret.
# See README.md "Repository Structure" for what each service does.

NODE_ENV=development
LOG_LEVEL=debug

# ---- Service ports (local dev) ----------------------------------------
PORT_HOLDER_WEB=3000
PORT_COORDINATOR_CONSOLE=3001
PORT_INGESTION_SVC=4001
PORT_DEID_SVC=4002
PORT_FHIR_MAPPER_SVC=4003
PORT_ISSUANCE_SVC=4004
PORT_ISSUER_REGISTRY_SVC=4005
PORT_CLAIM_SCHEMA_SVC=4006
PORT_DISCLOSURE_GUARD_SVC=4007
PORT_VERIFIER_API_SVC=4008
PORT_TRIAGE_AGENT_SVC=4009
PORT_AUDIT_SVC=4010

# ---- Datastores ---------------------------------------------------------
# Postgres holds only credential/issuer/claim-schema METADATA — never raw
# health data or de-identification inputs. See services/*/README.md.
DATABASE_URL=postgresql://passport:passport@localhost:5432/passport
REDIS_URL=redis://localhost:6379

# ---- Observability --------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=passport

# ---- Midnight Network -----------------------------------------------------
# Local proof server, started via `docker compose up midnight-proof-server`.
# See contracts/midnight/README.md for toolchain install.
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300
MIDNIGHT_NETWORK_ID=undeployed
# Fill in once you have testnet RPC/indexer endpoints:
MIDNIGHT_NODE_URL=
MIDNIGHT_INDEXER_URL=

# ---- Issuer signing (issuance-svc) -----------------------------------------
# Dev-only keypair placeholder — replace with a real accredited-issuer key
# management flow (HSM / KMS) before any non-local use.
ISSUER_SIGNING_KEY=
