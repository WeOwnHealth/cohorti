{
  // Typecheck config for the deploy tooling (scripts/ + src/).
  // The runner (node --experimental-strip-types) does not compile; this only
  // keeps the deploy path under the same strictness as the CI typecheck.
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "lib": ["ESNext"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strict": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["src/test", "src/deploy.ts"]
}
