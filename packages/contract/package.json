{
  "name": "@weownhealth/trials-contract",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "description": "HealthClaimGate — Wave-1 Compact contract for WeOwnHealth/trials (Midnight Buildathon #1)",
  "scripts": {
    "fetch:compact": "fetch-compactc --version=0.31.1",
    "compact": "COMPACTC_VERSION=0.31.1 run-compactc --skip-zk src/health_claim_gate.compact ./src/managed/health-claim-gate",
    "compact:zk": "COMPACTC_VERSION=0.31.1 run-compactc src/health_claim_gate.compact ./src/managed/health-claim-gate",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy:preprod": "node --experimental-strip-types scripts/preprod-deploy.ts",
    "typecheck:deploy": "tsc -p tsconfig.scripts.json --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-compact": "4.1.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "^3.1.2",
    "@midnight-ntwrk/wallet-sdk-facade": "^4.1.0",
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.2",
    "@midnight-ntwrk/wallet-sdk-shielded": "^3.0.1",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "^3.1.0",
    "pino": "^10.3.1",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.1"
  },
  "resolutions": {
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/wallet-sdk": "1.2.0"
  }
}
